// ============================================================
// Read voltage using ADS1115 and calibrated divider
// ============================================================
float readNodeVoltage(uint8_t channel, float dividerRatio) {
  // Average multiple ADS1115 samples to reduce I2C/ADC noise.
  // The divider calibration factors are the proven multimeter-matched
  // values from the previous working Battery Guardian setup.
  const uint8_t SAMPLES = 8;
  long rawSum = 0;

  for (uint8_t i = 0; i < SAMPLES; i++) {
    rawSum += ads.readADC_SingleEnded(channel);
    delayMicroseconds(200);
  }

  int16_t rawAverage = (int16_t)(rawSum / SAMPLES);
  float adcVoltage = ads.computeVolts(rawAverage);

  if (adcVoltage < 0.0f) {
    adcVoltage = 0.0f;
  }

  return adcVoltage * dividerRatio;
}

// ============================================================
// CRITICAL TIMING
// ============================================================
int getCriticalSeverity() {
  int severity = 1;

  // These severity bands are intentionally stricter than the critical
  // thresholds: crossing critical enters CRITICAL; how far beyond the
  // threshold determines the response time.
  if (maxTemp >= 55.0) severity = max(severity, 3);
  else if (maxTemp >= 51.0) severity = max(severity, 2);

  if (minCell < 2.80 || maxCell > 4.35) severity = max(severity, 3);
  else if (minCell < 2.90 || maxCell > 4.30) severity = max(severity, 2);

  if (cellImbalance >= 0.20) severity = max(severity, 3);
  else if (cellImbalance >= 0.15) severity = max(severity, 2);

  if (currentA >= 5.0) severity = max(severity, 3);
  else if (currentA >= 4.0) severity = max(severity, 2);

  if (packVoltage < 8.70 || packVoltage > 13.00) severity = max(severity, 3);
  else if (packVoltage < 8.90 || packVoltage > 12.90) severity = max(severity, 2);

  return severity;
}

void calculateCriticalTimes() {
  criticalSeverity = getCriticalSeverity();

  if (criticalSeverity >= 3) {
    criticalActualDurationMillis = 30000UL;
    criticalDisplayedDurationMillis = 15000UL;
  } else if (criticalSeverity == 2) {
    criticalActualDurationMillis = 60000UL;
    criticalDisplayedDurationMillis = 30000UL;
  } else {
    criticalActualDurationMillis = 90000UL;
    criticalDisplayedDurationMillis = 45000UL;
  }
}

int getCriticalDisplayedSecondsRemaining() {
  if (!criticalTimerActive) return 0;
  unsigned long elapsed = millis() - criticalStartMillis;
  if (elapsed >= criticalDisplayedDurationMillis) return 0;
  return (int)((criticalDisplayedDurationMillis - elapsed + 999UL) / 1000UL);
}

int getCriticalActualSecondsRemaining() {
  if (!criticalTimerActive) return 0;
  unsigned long elapsed = millis() - criticalStartMillis;
  if (elapsed >= criticalActualDurationMillis) return 0;
  return (int)((criticalActualDurationMillis - elapsed + 999UL) / 1000UL);
}

bool criticalIsolationExpired() {
  return criticalTimerActive &&
         ((millis() - criticalStartMillis) >= criticalActualDurationMillis);
}

void startCriticalTimer() {
  calculateCriticalTimes();
  criticalStartMillis = millis();
  criticalTimerActive = true;
  criticalRelayCutoff = false;
}

// ============================================================
// Evaluate NORMAL / WARNING / CRITICAL
// ============================================================
SystemState evaluateState() {
  warningReason = "";

  // Keep the original critical reason after the critical latch is set.
  if (criticalLatched) {
    return STATE_CRITICAL;
  }

  criticalReason = "";

  // -------- CRITICAL: highest priority --------
  if (maxTemp >= TEMP_CRIT_MAX) {
    criticalReason = "OVER TEMP";
    criticalLatched = true;
    return STATE_CRITICAL;
  }

  if (minCell < CELL_CRIT_MIN) {
    criticalReason = "CELL UNDER V";
    criticalLatched = true;
    return STATE_CRITICAL;
  }

  if (maxCell > CELL_CRIT_MAX) {
    criticalReason = "CELL OVER V";
    criticalLatched = true;
    return STATE_CRITICAL;
  }

  if (cellImbalance > IMBALANCE_CRIT) {
    criticalReason = "CELL IMBALANCE";
    criticalLatched = true;
    return STATE_CRITICAL;
  }

  if (currentA >= CURRENT_CRIT_MAX) {
    criticalReason = "OVER CURRENT";
    criticalLatched = true;
    return STATE_CRITICAL;
  }

  if (packVoltage < PACK_CRIT_MIN) {
    criticalReason = "PACK UNDER V";
    criticalLatched = true;
    return STATE_CRITICAL;
  }

  if (packVoltage > PACK_CRIT_MAX) {
    criticalReason = "PACK OVER V";
    criticalLatched = true;
    return STATE_CRITICAL;
  }

  // -------- WARNING --------
  if (maxTemp >= TEMP_NORMAL_MAX && maxTemp < TEMP_CRIT_MAX) {
    warningReason = "TEMP RISING";
    return STATE_WARNING;
  }

  if (minCell < CELL_NORMAL_MIN && minCell >= CELL_CRIT_MIN) {
    warningReason = "LOW CELL V";
    return STATE_WARNING;
  }

  if (maxCell > CELL_NORMAL_MAX && maxCell <= CELL_CRIT_MAX) {
    warningReason = "HIGH CELL V";
    return STATE_WARNING;
  }

  if (cellImbalance > IMBALANCE_CRIT) {
    warningReason = "CELL IMBALANCE";
    return STATE_WARNING;
  }

  if (currentA >= CURRENT_NORMAL_MAX && currentA < CURRENT_CRIT_MAX) {
    warningReason = "HIGH CURRENT";
    return STATE_WARNING;
  }

  if ((packVoltage >= PACK_WARN_LOW && packVoltage < PACK_NORMAL_MIN) ||
      (packVoltage > PACK_NORMAL_MAX && packVoltage <= PACK_WARN_HIGH)) {
    warningReason = "PACK VOLTAGE";
    return STATE_WARNING;
  }

  return STATE_NORMAL;
}

// ============================================================
// Start / update warning timer
// ============================================================
void updateCriticalTimer(SystemState newState) {
  // WARNING and NORMAL never run the critical timer.
  if (newState != STATE_CRITICAL) {
    criticalTimerActive = false;
    criticalRelayCutoff = false;
    previousState = newState;
    return;
  }

  // Start exactly once, on the transition into CRITICAL.
  if (previousState != STATE_CRITICAL && !criticalTimerActive) {
    startCriticalTimer();
  }

  // The displayed countdown and actual cutoff are independent.
  // Displayed time may reach 0 while relay remains ON.
  if (criticalTimerActive && criticalIsolationExpired()) {
    criticalRelayCutoff = true;
  }

  previousState = newState;
}

// ============================================================
// Update ML time features
// ============================================================
void updateTimeFeatures() {
  unsigned long now = millis();

  if (previousFeatureTime == 0) {
    previousFeatureTime = now;
    previousPackVoltage = packVoltage;
    previousMaxTemp = maxTemp;
    previousCurrentA = currentA;
    dVdt = 0.0;
    dTdt = 0.0;
    dIdt = 0.0;
    return;
  }

  float dt = (now - previousFeatureTime) / 1000.0;

  if (dt > 0.0) {
    dVdt = (packVoltage - previousPackVoltage) / dt;
    dTdt = (maxTemp - previousMaxTemp) / dt;
    dIdt = (currentA - previousCurrentA) / dt;
  }

  previousFeatureTime = now;
  previousPackVoltage = packVoltage;
  previousMaxTemp = maxTemp;
  previousCurrentA = currentA;
}

// ============================================================
// Internal resistance estimate
// Note: useful as a prototype feature, not a lab-grade test.
// ============================================================
void updateInternalResistance() {
  if (currentA < 0.03) {
    vOpenCircuit = packVoltage;
    rInt_mOhm = 0.0;
    return;
  }

  float vDrop = vOpenCircuit - packVoltage;

  if (currentA > 0.10 && vDrop > 0.01) {
    rInt_mOhm = (vDrop / currentA) * 1000.0;
  } else {
    rInt_mOhm = 0.0;
  }
}

