// ============================================================
// RELAY CONTROL
//
// NORMAL  -> Relay ON  (battery/load path allowed)
// WARNING -> Relay ON  (system continues; warning is advisory)
// CRITICAL -> Relay OFF IMMEDIATELY (load isolation)
//
// For this user's active-HIGH relay module:
//   HIGH = relay ON
//   LOW  = relay OFF
// ============================================================
void setRelay(bool on) {
  bool outputLevel;

  if (RELAY_ACTIVE_LOW) {
    outputLevel = on ? LOW : HIGH;
  } else {
    outputLevel = on ? HIGH : LOW;
  }

  digitalWrite(RELAY_PIN, outputLevel);
}

// ============================================================
// BUZZER CONTROL
//
// GPIO26 is used for the buzzer.
//
// WARNING  -> short beep, pause, repeat
// CRITICAL -> fast beep, pause, repeat
// NORMAL   -> OFF
//
// tone() is used so this also works with a passive piezo buzzer.
// For an active buzzer, the alternating HIGH/LOW pattern also
// produces an audible alarm.
// ============================================================
void startBuzzerTone(unsigned int frequency) {
  // GPIO26 drives the active buzzer directly.
  // The frequency argument is retained so the rest of the program
  // can call the same function for warning/critical alarms.
  (void)frequency;
  digitalWrite(BUZZER_PIN, HIGH);
}

void stopBuzzerTone() {
  digitalWrite(BUZZER_PIN, LOW);
}

void updateBuzzer() {
  unsigned long now = millis();

  // After the ACTUAL critical cutoff, buzzer must remain OFF.
  if (criticalRelayCutoff) {
    stopBuzzerTone();
    buzzerState = false;
    return;
  }

  if (currentState == STATE_NORMAL) {
    stopBuzzerTone();
    buzzerState = false;
    lastBuzzerMillis = now;
  }
  else if (currentState == STATE_WARNING) {
    // Active buzzer: 250 ms ON / 750 ms OFF
    unsigned long interval = buzzerState
        ? WARNING_BUZZ_ON_MS
        : WARNING_BUZZ_OFF_MS;

    if (now - lastBuzzerMillis >= interval) {
      lastBuzzerMillis = now;
      buzzerState = !buzzerState;

      if (buzzerState) {
        startBuzzerTone(1);
      } else {
        stopBuzzerTone();
      }
    }
  }
  else {  // STATE_CRITICAL
    // Active buzzer: 120 ms ON / 120 ms OFF
    unsigned long interval = buzzerState
        ? CRITICAL_BUZZ_ON_MS
        : CRITICAL_BUZZ_OFF_MS;

    if (now - lastBuzzerMillis >= interval) {
      lastBuzzerMillis = now;
      buzzerState = !buzzerState;

      if (buzzerState) {
        startBuzzerTone(1);
      } else {
        stopBuzzerTone();
      }
    }
  }
}

// ============================================================
// STATUS LED CONTROL
//
// NORMAL:
//   Green ON, Yellow OFF, Red OFF
//
// WARNING:
//   Green OFF, Yellow ON, Red BLINKS
//
// CRITICAL:
//   Green OFF, Yellow OFF, Red BLINKS FAST
//
// This function is called continuously from loop(), so the
// LEDs can blink without blocking sensor measurements.
// ============================================================
void updateStatusLEDs() {
  unsigned long now = millis();

  if (currentState == STATE_NORMAL) {
    digitalWrite(GREEN_LED_PIN, HIGH);
    digitalWrite(YELLOW_LED_PIN, LOW);
    digitalWrite(RED_LED_PIN, LOW);
    setRelay(true);
    redLedState = false;
    lastRedBlinkMillis = now;
  }
  else if (currentState == STATE_WARNING) {
    digitalWrite(GREEN_LED_PIN, LOW);
    digitalWrite(YELLOW_LED_PIN, HIGH);
    setRelay(true);
    if (now - lastRedBlinkMillis >= WARNING_RED_BLINK_MS) {
      lastRedBlinkMillis = now;
      redLedState = !redLedState;
      digitalWrite(RED_LED_PIN, redLedState ? HIGH : LOW);
    }
  }
  else {
    // FINAL critical cutoff:
    // relay OFF + buzzer OFF + ALL LEDs OFF.
    if (criticalRelayCutoff) {
      setRelay(false);
      digitalWrite(GREEN_LED_PIN, LOW);
      digitalWrite(YELLOW_LED_PIN, LOW);
      digitalWrite(RED_LED_PIN, LOW);
      stopBuzzerTone();
      buzzerState = false;
      return;
    }

    digitalWrite(GREEN_LED_PIN, LOW);
    digitalWrite(YELLOW_LED_PIN, LOW);

    // OLED safe-time reaching 0 does NOT cut the relay.
    // Relay remains ON until the longer ACTUAL critical timer expires.
    if (criticalTimerActive && !criticalIsolationExpired()) {
      setRelay(true);
    } else {
      criticalRelayCutoff = true;
      setRelay(false);
      digitalWrite(GREEN_LED_PIN, LOW);
      digitalWrite(YELLOW_LED_PIN, LOW);
      digitalWrite(RED_LED_PIN, LOW);
      stopBuzzerTone();
      buzzerState = false;
      return;
    }

    if (now - lastRedBlinkMillis >= CRITICAL_RED_BLINK_MS) {
      lastRedBlinkMillis = now;
      redLedState = !redLedState;
      digitalWrite(RED_LED_PIN, redLedState ? HIGH : LOW);
    }
  }
}

// ============================================================
// Setup
// ============================================================
void setup() {
  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);
  // Active buzzer on GPIO26: simple digital ON/OFF control.
Serial.begin(115200);
  delay(1000);

  Serial.println();
  Serial.println(F("=============================================="));
  Serial.println(F("       BATTERY GUARDIAN STARTING"));
  Serial.println(F("=============================================="));

  // Status LED pins
  pinMode(GREEN_LED_PIN, OUTPUT);
  pinMode(YELLOW_LED_PIN, OUTPUT);
  pinMode(RED_LED_PIN, OUTPUT);
  pinMode(RELAY_PIN, OUTPUT);

  // Safe startup:
  // LEDs OFF and relay OFF until the first sensor evaluation.
  // After evaluation: NORMAL/WARNING -> ON, CRITICAL -> OFF.
  digitalWrite(GREEN_LED_PIN, LOW);
  digitalWrite(YELLOW_LED_PIN, LOW);
  digitalWrite(RED_LED_PIN, LOW);
  stopBuzzerTone();
  setRelay(false);
  criticalLatched = false;
  criticalTimerActive = false;
  criticalRelayCutoff = false;

  Wire.begin(I2C_SDA, I2C_SCL);

  // OLED
  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDRESS)) {
    Serial.println(F("ERROR: OLED initialization failed."));
    while (true) delay(100);
  }
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(16, 20);
  display.println(F("BATTERY GUARDIAN"));
  display.setCursor(12, 35);
  display.println(F("Initializing..."));
  display.display();

  // ADS1115 - IMPORTANT: voltage dividers are connected here
  if (!ads.begin(ADS_ADDRESS)) {
    Serial.println(F("ERROR: ADS1115 not detected."));
    while (true) delay(100);
  }

  // Gain ONE = +/-4.096 V.
  // With 3S pack and 100k/33k divider, ADC input remains below 4.096 V.
  ads.setGain(GAIN_ONE);

  Serial.println(F("SUCCESS: ADS1115 detected at 0x48."));

  // INA219
  if (!ina219.begin()) {
    Serial.println(F("ERROR: INA219 not detected."));
    while (true) delay(100);
  }

  // Keep the same calibration used by the previous working setup.
  ina219.setCalibration_32V_2A();

  Serial.println(F("SUCCESS: INA219 detected at 0x40."));
  Serial.println(F("INA219 output: CURRENT + POWER only."));
  Serial.println(F("Bus voltage intentionally NOT used/displayed."));
  Serial.println(F("Relay: ACTIVE-HIGH, GPIO27 HIGH = ON."));
  Serial.println(F("Buzzer: GPIO26, tone alarm enabled."));

  // DS18B20
  tempSensor.begin();
  int sensorCount = tempSensor.getDeviceCount();

  Serial.printf("DS18B20 sensors found: %d\n", sensorCount);

  if (sensorCount < 3) {
    Serial.println(F("WARNING: Less than 3 DS18B20 sensors detected."));
  }

  delay(1500);
}

void runMachineLearningInference() {
  double raw_features[23];
  raw_features[0] = 12000.0;                   // DURATION_S (estimated discharge cycle duration)
  raw_features[1] = vNode3;                    // V_START
  raw_features[2] = packVoltage;               // V_END
  raw_features[3] = minCell;                   // V_MIN
  raw_features[4] = maxCell;                   // V_MAX
  raw_features[5] = avgCell;                   // V_MEAN
  raw_features[6] = (raw_features[1] - packVoltage); // V_DROP
  raw_features[7] = dVdt;                      // VOLTAGE_SLOPE
  raw_features[8] = 1.0;                       // V_STD
  raw_features[9] = 0.0;                       // V_SKEW
  raw_features[10] = currentA;                 // I_MEAN
  raw_features[11] = currentA;                 // I_MIN
  raw_features[12] = currentA;                 // I_MAX
  raw_features[13] = t1;                       // T_START
  raw_features[14] = maxTemp;                  // T_END
  raw_features[15] = t1;                       // T_MIN
  raw_features[16] = maxTemp;                  // T_MAX
  raw_features[17] = avgTemp;                  // T_MEAN
  raw_features[18] = (maxTemp - t1);           // TEMP_RISE
  raw_features[19] = dTdt;                     // TEMP_RISE_RATE
  raw_features[20] = 0.98;                     // TEMP_STD
  raw_features[21] = rInt_mOhm / 1000.0;       // DC_IR converted to ohms
  raw_features[22] = powerW * (1.0 / 3600.0);  // ENERGY_WH approximation

  // Scale features for Ridge Regression (SoH)
  double scaled_features[23];
  for (int i = 0; i < 23; i++) {
    scaled_features[i] = (raw_features[i] - FEATURE_MEANS[i]) / FEATURE_SCALES[i];
  }

  // Execute C functions generated from your models
  predictedSoH = score(scaled_features); // Ridge regression for SoH
  // Note: if m2cgen generated 'score' for both headers, check rul_model.h to see if it's also score() or score_rul()
  predictedRUL = score(raw_features);    // Random Forest for RUL
}


// ============================================================
// Main Loop
// ============================================================
void loop() {
  unsigned long now = millis();

  // Check the actual critical cutoff continuously.
  // The shorter OLED timer may already be at 0; relay cutoff occurs
  // only when the longer ACTUAL timer expires.
  if (criticalTimerActive && criticalIsolationExpired()) {
    criticalRelayCutoff = true;
  }

  // Update LEDs and buzzer continuously so alarms/blinking are
  // smooth and independent of the 1-second sensor-read interval.
  updateStatusLEDs();
  updateBuzzer();

  // Switch OLED page every 10 seconds
  if (now - lastPageSwapTime >= PAGE_INTERVAL) {
    lastPageSwapTime = now;
    showStatusPage = !showStatusPage;
  }

  // Sensor update every 1 second
  if (now - lastSensorReadTime >= SENSOR_INTERVAL) {
    lastSensorReadTime = now;

// --------------------------------------------------------
    // 4. DERIVED ML FEATURES & INFERENCE
    // --------------------------------------------------------
    updateTimeFeatures();
    updateInternalResistance();
    
    // --> RUN THE ML MODELS LIVE <--
    runMachineLearningInference();
    // --------------------------------------------------------
    // 1. READ ADS1115 VOLTAGES
    // --------------------------------------------------------
    // A0 = Node 1 / Cell 1 positive
    // A1 = Node 2 / Cell 1 + Cell 2
    // A2 = Node 3 / full 3S pack
    vNode1 = readNodeVoltage(0, DIVIDER_RATIO_1);
    vNode2 = readNodeVoltage(1, DIVIDER_RATIO_2);
    vNode3 = readNodeVoltage(2, DIVIDER_RATIO_3);

    // Differential cell voltages
    vCell1 = vNode1;
    vCell2 = vNode2 - vNode1;
    vCell3 = vNode3 - vNode2;

    if (vCell1 < 0.0) vCell1 = 0.0;
    if (vCell2 < 0.0) vCell2 = 0.0;
    if (vCell3 < 0.0) vCell3 = 0.0;

    packVoltage = vNode3;

    minCell = min(vCell1, min(vCell2, vCell3));
    maxCell = max(vCell1, max(vCell2, vCell3));
    avgCell = (vCell1 + vCell2 + vCell3) / 3.0;
    cellImbalance = maxCell - minCell;

    // --------------------------------------------------------
    // 2. INA219 - CURRENT ONLY
    // --------------------------------------------------------
    float measuredCurrentA = ina219.getCurrent_mA() / 1000.0;

    // Magnitude is used for protection/ML feature.
    // Direction is not needed for the current prototype.
    currentA = fabs(measuredCurrentA);

    // Power is calculated from the independently measured pack
    // voltage, not INA219 bus voltage.
    powerW = packVoltage * currentA;

    // --------------------------------------------------------
    // 3. TEMPERATURES
    // --------------------------------------------------------
    tempSensor.requestTemperatures();

    t1 = tempSensor.getTempCByIndex(0);
    t2 = tempSensor.getTempCByIndex(1);
    t3 = tempSensor.getTempCByIndex(2);

    maxTemp = max(t1, max(t2, t3));
    avgTemp = (t1 + t2 + t3) / 3.0;

    float minTemp = min(t1, min(t2, t3));
    tempDifference = maxTemp - minTemp;

    // --------------------------------------------------------
    // 4. DERIVED ML FEATURES & INFERENCE
    // --------------------------------------------------------
    updateTimeFeatures();
    updateInternalResistance();

	// --> RUN THE ML MODELS LIVE <--
	runMachineLearningInference();

    // --------------------------------------------------------
    // 5. STATE EVALUATION
    // --------------------------------------------------------
    currentState = evaluateState();

    // --------------------------------------------------------
    // 5A. LOAD CURRENT ZERO AFTER CRITICAL CUTOFF
    // --------------------------------------------------------
    // The verified hardware test showed:
    //   CRITICAL -> COM-NO OPEN
    //   Load voltage -> ~0 V
    //   NO -> P- -> ~0 V
    // Therefore there is no load current after relay cutoff.
    // The INA219 is upstream of the relay, so its residual/stale
    // current register value must not be shown as load current.
    if (currentState == STATE_CRITICAL) {
      // Before actual cutoff, show real current/power. After relay opens,
      // show the verified load state as zero.
      if (criticalRelayCutoff || criticalIsolationExpired()) {
        currentA = 0.0f;
        powerW = 0.0f;
      } else {
        if (fabs(currentA) < 0.05f) currentA = 0.0f;
        powerW = packVoltage * currentA;
      }
    } else {
      if (fabs(currentA) < 0.05f) currentA = 0.0f;
      powerW = packVoltage * currentA;
    }

    // --------------------------------------------------------
    // 6. WARNING TIMER
    // --------------------------------------------------------
    updateCriticalTimer(currentState);

    // Final output interlock after actual critical cutoff.
    if (criticalRelayCutoff) {
      setRelay(false);
      digitalWrite(GREEN_LED_PIN, LOW);
      digitalWrite(YELLOW_LED_PIN, LOW);
      digitalWrite(RED_LED_PIN, LOW);
      stopBuzzerTone();
      buzzerState = false;
      currentA = 0.0f;
      powerW = 0.0f;
    }

    // --------------------------------------------------------
    // 7. SERIAL OUTPUT
    // --------------------------------------------------------
    printSerial();

    // --------------------------------------------------------
    // 8. OLED OUTPUT
    // --------------------------------------------------------
    if (currentState == STATE_CRITICAL) {
      displayCritical();
    } else if (currentState == STATE_WARNING) {
      if (showStatusPage) {
        displayStatusPage();
      } else {
        displayWarning();
      }
    } else {
      if (showStatusPage) {
        displayStatusPage();
      } else {
        displayNormal();
      }
    }
  }
}
